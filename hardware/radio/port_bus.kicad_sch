left)) (uuid "7b0d5c88-8911-5560-9770-02b4639f0857"))(symbol (lib_id "Babel_Radio:ESD2") (at 154.94 142.24 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "efc515ab-3789-522a-99d5-79167dc6d9e4") (property "Reference" "U33" (at 154.94 130.16 0) (effects (font (size 1 1)) ))(property "Value" "TPD2E2U06DCKR" (at 154.94 133.16 0) (effects (font (size 1 1)) ))(property "Footprint" "Package_TO_SOT_SMD:SOT-323_SC-70" (at 154.94 142.24 0) (effects (font (size 1 1)) (hide yes)))(property "Datasheet" "https://www.ti.com/lit/ds/symlink/tpd2e2u06.pdf" (at 154.94 142.24 0) (effects (font (size 1 1)) (hide yes))) (instances (project "babel-radio" (path "/d5e4457b-ffe5-59c4-b232-e872d84db4bc/1e67ca66-f0b2-5390-9e2e-547bbd24bedd" (reference "U33") (unit 1)))))(wire (pts (xy 132.08 140.97) (xy 129.54 140.97)) (stroke (width 0) (type default)) (uuid "d8fcfa77-8e54-52b4-bf66-a133221d5ff7"))(global_label "SENSOR_IRQ_N" (shape bidirectional) (at 129.54 140.97 180) (effects (font (size 0.85 0.85)) (justify right)) (uuid "ae363474-8112-5b43-b533-02c3003d47b0"))(no_connect (at 132.08 143.51) (uuid "3925470e-458f-5d97-ba29-6a8c194b73e1"))(wire (pts (xy 177.8 140.97) (xy 180.34 140.97)) (stroke (width 0) (type default)) (uuid "1c03fb39-7232-573c-9eed-2395589a84a0"))(global_label "GND" (shape bidirectional) (at 180.34 140.97 0) (effects (font (size 0.85 0.85)) (justify left)) (uuid "8c89f658-e179-514a-84bb-748434ca886b"))(text "J1: MEC1-110-02-L-D-NP-A. Mirrored pinout: contact n and 21-n carry the same net, so a card works either way round.\nU12 isolates NVM. U13 isolates sensor SCL/SDA/IRQ as one group. I2C-only daughters; no SPI/UART/RESET contacts.\nAll daughter-facing pull-ups reference VDD_DAUGHTER; MCU internal pull-ups must be off before isolation.\nNVM_WP is an open-drain host control. IRQ_N is open-drain from daughter (contacts 4/17).\nHost I2C pull-ups are 4.7k. IR daughter optional pull-ups remain DNP. Qualify capacitance and rise time.\nTPD2E2U06 arrays protect connector signals. Stuck-bus recovery is firmware; system ESD still needs testing." (at 12 165.02 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "622bf7db-7d93-57f8-9955-fd367af435dd")))
