(effects (font (size 1 1)) (justify left)) (uuid "d08ed48c-3a97-5c4e-9a80-30fa76373f9f"))(wire (pts (xy 228.6 48.26) (xy 228.6 44.45)) (stroke (width 0) (type default)) (uuid "889abb6a-2842-5b66-b387-21853bf45907"))(global_label "VDD_DAUGHTER" (shape bidirectional) (at 228.6 44.45 0) (effects (font (size 1 1)) (justify left)) (uuid "567ea4ee-d729-5216-8dba-95b4d007b849"))(text "Pin 8 = PRESENT_N, strapped to GND. VDD on 3 and 18.\nHost mirrors n/21-n: works either way round.\nPin 4 (host SENSOR_IO2) and 11-17 unused here.\nMEC1 NP: odd front / even back; 1.57mm PCB.\nPower OFF to swap. See radio/MECHANICAL.md." (at 15 86 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "f62c40c4-9719-56a3-b8f5-8b02b02256a5"))(text "SMBus address 0x5A (in sensor EEPROM), 100 kHz max.\n3 V part (Bxx), 35 deg FOV; preserve optical clearance.\nPlace C1 close to U1 pins 3/4. Can is VSS only.\nObject/ambient temperatures read directly (no host math)." (at 115 86 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "26b6e232-9830-59e1-b0d2-402a7ebdf66c"))(text "A0-A2 low: address 0x50.\nSeparate NVM bus; WP high protects writes.\n32 KiB is provisional until Wasm build measured.\nNo runtime data logging in driver EEPROM." (at 210 86 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "5f07b60d-181d-5a3f-8bed-126a43b07daf"))(text "04 / DECOUPLING" (at 15 111 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "2367b6b9-5bd4-5604-96cd-0762b596bdfe"))(symbol (lib_id "Babel_IR:C") (at 22.86 133.35 0) (unit 1)
